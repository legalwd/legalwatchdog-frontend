{
  "name": "legal-watch-dog-fe",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && pnpm build-only",
    "build:blog-css": "vite build --config vite.blog-css.config.ts && rm -f public/assets/blog/blog-css.v1.js",
    "watch:blog-css": "vite build --config vite.blog-css.config.ts --watch",
    "preview": "vite preview",
    "test": "pnpm test:unit:run",
    "test:unit": "vitest",
    "test:unit:run": "vitest run --passWithNoTests",
    "build-only": "vite-ssg build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache",
    "lint:strict": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:staged": "lint-staged",
    "format:check": "prettier --check .",
    "ci": "pnpm lint:strict && pnpm format:check && pnpm type-check && pnpm test:unit:run && pnpm build",
    "audit:lighthouse:marketing": "node scripts/run-lighthouse-audit.mjs",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md,css,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^3.0.0",
    "@hugeicons/vue": "^1.0.3",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "lucide-vue-next": "^0.561.0",
    "marked": "^17.0.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.6.1",
    "sweetalert2": "^11.26.10",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.1.8",
    "@tailwindcss/vite": "^4.1.17",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.2",
    "@unhead/vue": "^2.0.19",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "@vitest/eslint-plugin": "^1.5.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.1.9",
    "eslint-plugin-vue": "~10.6.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.1.9",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "unplugin-vue-router": "^0.19.1",
    "vite": "^7.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-ssg": "^28.2.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.8"
  }
}
